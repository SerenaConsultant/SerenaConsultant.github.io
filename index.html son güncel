<style>
:root{
  --forest:#0D3B2E;
  --forest-2:#145243;
  --green:#17694A;
  --green-bright:#1F8A5F;
  --mint:#E6F4EC;
  --mint-2:#CDE8DA;
  --lime:#C9EA6A;
  --paper:#F7FBF8;
  --ink:#10241C;
  --muted:#46594F;
  --line:#D3E3D9;
  --head:"Bricolage Grotesque", "Segoe UI", system-ui, sans-serif;
  --body:"Figtree", system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
  --wrap:1160px;
  color-scheme: light;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:84px}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.65;-webkit-font-smoothing:antialiased}
a{color:inherit}
:focus-visible{outline:3px solid var(--lime);outline-offset:3px;border-radius:6px}
header.site :focus-visible,.light :focus-visible{outline-color:var(--green)}
.wrap{max-width:var(--wrap);margin:0 auto;padding:0 28px}
.skip{position:absolute;left:-999px;top:8px;background:var(--forest);color:#fff;padding:10px 16px;border-radius:8px;z-index:100}
.skip:focus{left:12px}
h1,h2,h3{font-family:var(--head);margin:0}

/* Buttons */
.btn{display:inline-block;font:inherit;font-size:16px;font-weight:600;text-decoration:none;padding:15px 28px;border-radius:999px;border:2px solid var(--green);background:var(--green);color:#fff;transition:transform .2s,background .2s,color .2s}
.btn:hover{background:var(--forest);border-color:var(--forest);transform:translateY(-2px)}
.btn.lime{background:var(--lime);border-color:var(--lime);color:var(--forest)}
.btn.lime:hover{background:#fff;border-color:#fff;color:var(--forest)}
.btn.line{background:transparent;color:#fff;border-color:rgba(255,255,255,.55)}
.btn.line:hover{background:rgba(255,255,255,.14);border-color:#fff}
.btn.sm{padding:10px 20px;font-size:15px}
.actions{display:flex;flex-wrap:wrap;gap:14px}

/* Header */
header.site{position:sticky;top:0;z-index:50;background:rgba(247,251,248,.94);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;justify-content:space-between;gap:20px;height:74px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;font-family:var(--head);font-weight:700;font-size:21px;letter-spacing:-.2px}
.mono-logo{position:relative;flex:none;width:50px;height:46px;font-family:"Playfair Display",Georgia,"Times New Roman",serif;font-weight:400;line-height:1}
.mono-logo .s,.mono-logo .c{position:absolute;font-size:42px}
.mono-logo .s{left:3px;top:-5px;color:var(--forest)}
.mono-logo .c{left:17px;top:6px;color:var(--green-bright)}
nav.main{display:flex;gap:30px}
nav.main a{text-decoration:none;font-weight:500;font-size:15.5px;color:var(--muted);padding:6px 0;border-bottom:2px solid transparent}
nav.main a:hover{color:var(--green);border-bottom-color:var(--green-bright)}
.tools{display:flex;align-items:center;gap:14px}
.lang{display:inline-flex;border:1.5px solid var(--line);border-radius:999px;overflow:hidden;background:#fff}
.lang button{font:inherit;font-size:13px;font-weight:600;border:0;background:transparent;color:var(--muted);padding:7px 13px;cursor:pointer}
.lang button[aria-pressed="true"]{background:var(--forest);color:#fff}

/* Hero */
.hero{position:relative;overflow:hidden;background:radial-gradient(90% 120% at 85% 10%, #1B6B52 0%, var(--forest-2) 38%, var(--forest) 100%);color:#fff;padding:112px 0 124px}
.hero::before,.hero::after{content:"";position:absolute;border-radius:50%;border:1.5px solid rgba(201,234,106,.18);pointer-events:none}
.hero::before{width:620px;height:620px;left:-240px;bottom:-340px}
.hero::after{width:380px;height:380px;right:-120px;top:-170px}
.hero .grid{position:relative;max-width:880px;text-align:center}
.hero .actions{justify-content:center}
.hero h1{font-weight:700;font-size:clamp(40px,5.6vw,70px);line-height:1.04;letter-spacing:-1.4px;margin-bottom:26px}
.hero p.lead{font-size:19.5px;color:#D3E8DD;max-width:34em;margin:0 auto 38px}

/* Stats */
.stats{background:var(--mint);border-bottom:1px solid var(--line)}
.stats .wrap{display:grid;grid-template-columns:repeat(3,1fr)}
.stat{padding:38px 28px;text-align:center}
.stat+.stat{border-left:1px solid var(--mint-2)}
.stat .n{font-family:var(--head);font-weight:700;font-size:54px;line-height:1;color:var(--green);letter-spacing:-1px}
.stat p{margin:10px auto 0;color:var(--muted);max-width:15em}

/* Generic sections */
section{padding:104px 0}
.title{font-weight:700;font-size:clamp(32px,4vw,48px);line-height:1.1;letter-spacing:-.8px;margin-bottom:16px;max-width:16em}
.intro{color:var(--muted);font-size:18.5px;max-width:38em;margin:0 0 52px}

/* Services */
.cards{display:grid;grid-template-columns:1fr 1fr;gap:26px}
.card{background:#fff;border:1px solid var(--line);border-top:5px solid var(--green-bright);border-radius:22px;padding:36px 34px 32px;transition:transform .25s,box-shadow .25s}
.card:hover{transform:translateY(-4px);box-shadow:0 18px 40px -22px rgba(13,59,46,.45)}
.viz{background:var(--mint);border-radius:16px;margin:0 0 24px;overflow:hidden}
.viz svg{display:block;width:100%;height:auto}
.viz .gr{fill:none;stroke:#B5D8C4;stroke-width:1.5}
.viz .ax{fill:none;stroke:#B5D8C4;stroke-width:1.5}
.viz .dat{fill:rgba(31,138,95,.28);stroke:var(--green-bright);stroke-width:2.5;stroke-linejoin:round}
.viz .dt{fill:var(--green)}
.viz .trk{fill:var(--mint-2)}
.viz .fil{fill:var(--green-bright)}
.viz .fil2{fill:var(--green)}
.viz .lm{fill:var(--lime)}
.viz .cd{fill:#fff;stroke:#B5D8C4;stroke-width:1.5}
.viz .ln{fill:#DCE9E1}
.viz .ring{fill:#fff;stroke:#9CC9B1;stroke-width:2}
.viz .pl{fill:none;stroke:var(--green-bright);stroke-width:3;stroke-linecap:round;stroke-linejoin:round}
.viz .gl{stroke:#E1EDE6;stroke-width:1.5}
.card.soon .viz{background:#fff}
.card h3{font-size:25px;line-height:1.2;letter-spacing:-.3px;margin-bottom:10px}
.card .q{color:var(--green);font-weight:600;margin:0 0 18px}
.card ul{list-style:none;margin:0;padding:0}
.card li{position:relative;padding:0 0 10px 24px;color:var(--muted)}
.card li::before{content:"";position:absolute;left:0;top:.5em;width:12px;height:12px;border-radius:50%;background:var(--mint-2);box-shadow:inset 0 0 0 3.5px var(--green-bright)}
.note{font-size:14px;color:var(--muted);margin:8px 0 0}
.card.soon{background:var(--mint);border-style:dashed;border-top-style:dashed;border-top-width:2px;border-color:var(--green-bright)}
.card.soon:hover{transform:none;box-shadow:none}
.tag{display:inline-block;font-size:13px;font-weight:600;color:var(--forest);background:var(--lime);padding:3px 13px;border-radius:999px;margin-bottom:14px}

/* Approach */
#approach{background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.eq{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;align-items:stretch;gap:18px}
.eq .box{border-radius:24px;padding:34px 30px}
.eq .b1{background:var(--forest);color:#fff}
.eq .b2{background:var(--mint)}
.eq .b3{background:var(--lime);color:var(--forest)}
.eq h3{font-size:23px;line-height:1.2;margin-bottom:10px}
.eq p{margin:0}
.eq .b1 p{color:#CFE5D9}
.eq .b2 p{color:var(--muted)}
.eq .b3 p{color:#27421F}
.op{align-self:center;font-family:var(--head);font-weight:600;font-size:38px;color:var(--green)}
.how{display:grid;grid-template-columns:1fr 1fr;gap:0 56px;margin-top:64px}
.how div{border-top:2px solid var(--green-bright);padding:22px 0 34px}
.how h3{font-size:22px;margin-bottom:8px}
.how p{margin:0;color:var(--muted)}

/* Process */
.steps{position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:30px;margin-top:8px}
.steps::before{content:"";position:absolute;left:30px;right:30px;top:30px;height:2px;background:var(--mint-2)}
.step{position:relative}
.num{width:60px;height:60px;border-radius:50%;background:var(--green);color:#fff;font-family:var(--head);font-weight:700;font-size:24px;display:grid;place-items:center;margin-bottom:22px;box-shadow:0 0 0 8px var(--paper)}
.step h3{font-size:22px;margin-bottom:8px}
.step p{margin:0;color:var(--muted)}

/* About */
#about{background:var(--mint);border-top:1px solid var(--line)}
.about{display:grid;grid-template-columns:.8fr 1.2fr;gap:64px;align-items:center}
.portrait{position:relative;aspect-ratio:4/5;border-radius:30px;overflow:hidden;background:linear-gradient(150deg,var(--green-bright),var(--forest));display:grid;place-items:center;max-width:420px}
.portrait::before{content:"";position:absolute;width:75%;aspect-ratio:1;border-radius:50%;border:2px solid rgba(201,234,106,.35);right:-22%;top:-12%}
.portrait img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.about.nophoto{grid-template-columns:1fr;gap:0;max-width:820px}
.about p{margin:0 0 18px;max-width:36em}
.facts{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}
.facts span{font-size:15px;font-weight:600;color:var(--forest);background:#fff;border:1px solid var(--mint-2);padding:7px 16px;border-radius:999px}

/* Contact */
#contact{position:relative;overflow:hidden;background:linear-gradient(135deg,var(--green) 0%,var(--forest) 100%);color:#fff}
#contact::before{content:"";position:absolute;width:520px;height:520px;border-radius:50%;border:1.5px solid rgba(201,234,106,.22);right:-160px;top:-220px}
#contact .wrap{position:relative}
#contact .intro{color:#D3E8DD;margin-bottom:34px}
.cgrid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:56px}
.cbox{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);border-radius:18px;padding:20px 24px}
.cbox small{display:block;font-size:14px;color:#B9D4C6}
.cbox a,.cbox span{font-size:18px;text-decoration:none;word-break:break-word}
.cbox a:hover{text-decoration:underline}
footer.site{background:var(--forest);color:#A9C6B7;font-size:14px;border-top:1px solid rgba(255,255,255,.12)}
footer.site .wrap{padding-top:26px;padding-bottom:30px;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}

@media (max-width:960px){
  nav.main{display:none}
  .hero{padding:60px 0 72px}
  .cards,.about,.how{grid-template-columns:1fr}
  .eq{grid-template-columns:1fr}
  .op{justify-self:center;font-size:32px;line-height:1}
  .steps{grid-template-columns:1fr;gap:34px}
  .steps::before{left:29px;right:auto;top:30px;bottom:30px;width:2px;height:auto}
  .step{display:grid;grid-template-columns:60px 1fr;column-gap:22px}
  .step .num{grid-row:span 2;margin-bottom:0}
  .about{gap:36px}
  .how{gap:0}
  section{padding:72px 0}
  .stats .wrap{grid-template-columns:1fr}
  .stat+.stat{border-left:0;border-top:1px solid var(--mint-2)}
  .stat{padding:28px 20px}
  .cgrid{grid-template-columns:1fr}
}
@media (max-width:520px){
  .wrap{padding:0 20px}
  .tools .btn{display:none}
  .bar{height:66px}
  .card{padding:28px 24px}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .btn,.card{transition:none}
}
</style>
</head>
